# Hyperly (Windows-only personal build) - .env template
# All of these are OPTIONAL in this build. Hyperly Pro / payment / analytics
# services have been removed; the values below exist only so `cargo build`
# does not warn about missing `option_env!` symbols from build.rs.
#
# The Rust code no longer reads any of these at runtime, but the build script
# (`src-tauri/build.rs`) still emits them if they are present.

# Proxies / payment / analytics endpoints (no longer used)
PAYMENT_ENDPOINT=
API_ACCESS_KEY=
APP_ENDPOINT=
POSTHOG_API_KEY=
